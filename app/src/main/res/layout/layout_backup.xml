<?xml version="1.0" encoding="utf-8"?>
<!-- 备份页：按设计图（bei-fen-ye-gai-ban-she-ji-tu）严格实施。
     首屏三张卡只露关键信息，细节藏在四个入口后面。
     远程卡：图标 + 远程备份 / WebDAV · 坚果云 + 编辑；连通性圆点 + 状态；
     备份文件；立即备份（琥珀按钮 + 上次状态）；从云端恢复 >。
     点“编辑”才展开服务器/账号/密码字段。
     本地卡：图标 + 本地备份 / 导出成本机文件，或从文件导回；
     备份到文件 >（点开是勾选 + 导出/分享）、从文件恢复 >（直接选文件导入）。
     选项卡：图标 + 选项；自动备份开关 + 一行说明；保留策略；最近备份两条。
     恢复策略（覆盖/合并）不在选项卡，改到导入对话框里选（恢复时才 relevant）。
     卡片样式来自全局 Widget.Rift.CardView；页面底色跟随主题
     windowBackground（白天暖灰 #EDEAE3、夜间 #121212）。 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 远程：WebDAV（坚果云）。首屏只露摘要；点“编辑”才展开字段。 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- 卡头：图标 + 标题/副标题 + 编辑。 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/bg_icon_tile"
                        android:padding="12dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_file_cloud_queue"
                        android:tint="@color/color_rift_accent"
                        android:contentDescription="@string/webdav_title" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/webdav_title_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/backup_remote_title"
                            android:textAppearance="?attr/textAppearanceSubtitle1"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/webdav_subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/backup_remote_subtitle"
                            android:textColor="?android:textColorTertiary"
                            android:textSize="13sp" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/webdav_edit_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_grey_pill"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:paddingVertical="6dp"
                        android:paddingHorizontal="14dp"
                        android:text="@string/edit"
                        android:textColor="?android:textColorPrimary"
                        android:textSize="13sp" />

                </LinearLayout>

                <!-- 连通性圆点：灰=未检测，绿=正常，红=失败。进页已配置时自动测一次。 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/webdav_dot"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:text="●"
                        android:textColor="?android:textColorTertiary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/webdav_status"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="?android:textColorPrimary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/webdav_host"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="?android:textColorPrimary"
                        android:textSize="13sp" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:background="@color/color_rift_card_stroke" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/webdav_file_name" />

                    <TextView
                        android:id="@+id/webdav_file_name_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="?android:textColorTertiary" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/color_rift_card_stroke" />

                <!-- 立即备份：琥珀实心按钮 + 右端上次状态。 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="12dp">

                    <TextView
                        android:id="@+id/webdav_upload_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_amber_pill"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingVertical="10dp"
                        android:paddingHorizontal="18dp"
                        android:text="@string/webdav_backup_now"
                        android:textColor="@android:color/white"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/webdav_last_backup"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:textColor="?android:textColorTertiary" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/color_rift_card_stroke" />

                <LinearLayout
                    android:id="@+id/webdav_restore_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/webdav_restore_cloud" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textColor="?android:textColorTertiary"
                        android:textSize="18sp" />

                </LinearLayout>

                <!-- 细节（点“编辑”才展开）：服务器/账号/密码 + 提示。 -->
                <LinearLayout
                    android:id="@+id/webdav_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <EditText
                        android:id="@+id/webdav_server"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="@string/webdav_server"
                        android:inputType="textUri" />

                    <EditText
                        android:id="@+id/webdav_username"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/webdav_username"
                        android:inputType="textEmailAddress" />

                    <EditText
                        android:id="@+id/webdav_password"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/webdav_password"
                        android:inputType="textPassword" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/webdav_hint"
                        android:textColor="?android:textColorTertiary" />

                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 本地：首屏只露两行；点“备份到文件”才展开勾选 + 导出/分享。 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- 卡头：图标 + 标题/副标题。 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/bg_icon_tile"
                        android:padding="12dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_action_description"
                        android:tint="@color/color_rift_accent"
                        android:contentDescription="@string/backup_local_title" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/backup_local_title"
                            android:textAppearance="?attr/textAppearanceSubtitle1"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/backup_local_subtitle"
                            android:textColor="?android:textColorTertiary"
                            android:textSize="13sp" />

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/local_backup_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/local_backup_to_file" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:text="@string/backup_local_export_hint"
                        android:textColor="?android:textColorTertiary"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textColor="?android:textColorTertiary"
                        android:textSize="18sp" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/color_rift_card_stroke" />

                <LinearLayout
                    android:id="@+id/local_restore_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/local_restore_from_file" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textColor="?android:textColorTertiary"
                        android:textSize="18sp" />

                </LinearLayout>

                <!-- 细节（点“备份到文件”才展开）：勾选 + 导出/分享 + 恢复默认 + 说明。 -->
                <LinearLayout
                    android:id="@+id/local_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <Button
                        android:id="@+id/reset_settings"
                        style="@style/Widget.AppCompat.Button.Colored"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/reset_settings"
                        android:textColor="?whiteOrTextPrimary" />

                    <CheckBox
                        android:id="@+id/backup_configurations"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/backup_groups_and_configurations"
                        android:textAppearance="?attr/textAppearanceSubtitle2" />

                    <CheckBox
                        android:id="@+id/backup_rules"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/backup_rules"
                        android:textAppearance="?attr/textAppearanceSubtitle2" />

                    <CheckBox
                        android:id="@+id/backup_settings"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/settings"
                        android:textAppearance="?attr/textAppearanceSubtitle2" />

                    <!-- 导出内容（2026-11-10，规划第 5 项）：完整 / 匿名。
                         只影响“导出”和“分享”；WebDAV 上传与自动备份永远用完整档。
                         匿名去掉节点密钥、订阅链接与 WebDAV 账号，文件名带 anonymous。 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/export_tier_title"
                        android:textAppearance="?attr/textAppearanceSubtitle2"
                        android:textStyle="bold" />

                    <RadioGroup
                        android:id="@+id/export_tier_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <RadioButton
                            android:id="@+id/export_tier_full"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/export_tier_full" />

                        <RadioButton
                            android:id="@+id/export_tier_anonymous"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/export_tier_anonymous" />

                    </RadioGroup>

                    <Button
                        android:id="@+id/action_export"
                        style="@style/Widget.AppCompat.Button.Colored"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/action_export"
                        android:textColor="?whiteOrTextPrimary" />

                    <Button
                        android:id="@+id/action_share"
                        style="@style/Widget.AppCompat.Button.Colored"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/share"
                        android:textColor="?whiteOrTextPrimary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/backup_summary"
                        android:textColor="?android:textColorTertiary" />

                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 选项：自动备份开关 + 一行说明；保留策略；最近备份两条。
             常驻显示，不折叠。恢复策略（覆盖/合并）不在此卡，
             改到导入对话框里选（恢复时才 relevant）。
             预留位置（d）：以后备份相关新开关直接进这张卡，不另起页面。 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- 卡头：图标 + 标题。 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/bg_icon_tile"
                        android:padding="12dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_tune"
                        android:tint="@color/color_rift_accent"
                        android:contentDescription="@string/backup_options_title" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/backup_options_title"
                        android:textAppearance="?attr/textAppearanceSubtitle1"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- 自动备份：标题 + 一行说明 + 开关。 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/auto_backup_title"
                            android:textAppearance="?attr/textAppearanceSubtitle2" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/auto_backup_short"
                            android:textColor="?android:textColorTertiary"
                            android:textSize="13sp" />

                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/auto_backup_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:background="@color/color_rift_card_stroke" />

                <!-- 保留策略：云端留最新 5 份。 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/backup_retention_title" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/backup_history_keep5"
                        android:textColor="?android:textColorTertiary" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/color_rift_card_stroke" />

                <!-- 最近备份：自动一条、手动一条；没有就是“暂无”。 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/backup_recent_title"
                    android:textAppearance="?attr/textAppearanceSubtitle2"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/recent_backup_auto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="?android:textColorTertiary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/recent_backup_manual"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="?android:textColorTertiary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/auto_backup_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="?android:textColorTertiary"
                    android:textSize="13sp"
                    android:visibility="gone" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>

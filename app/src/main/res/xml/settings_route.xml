<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <!-- 设置子页卡片分组（2026-11-15）：每组收进一张白圆角卡片，标题为分组名。 -->
    <PreferenceCategory app:title="@string/settings_group_perapp_direct">
        <SwitchPreference
            app:icon="@drawable/ic_navigation_apps"
            app:key="proxyApps"
            app:summary="@string/proxied_apps_summary"
            app:title="@string/proxied_apps" />
        <SwitchPreference
            app:icon="@drawable/ic_baseline_legend_toggle_24"
            app:key="bypassLan"
            app:title="@string/route_opt_bypass_lan" />
        <SwitchPreference
            app:key="bypassLanInCore"
            app:title="@string/bypass_lan_in_core" />
    </PreferenceCategory>
    <PreferenceCategory app:title="@string/settings_group_traffic">
        <light.rift.core.ui.SimpleMenuPreference
            app:defaultValue="1"
            app:entries="@array/traffic_sniffing_values"
            app:entryValues="@array/int_array_3"
            app:icon="@drawable/ic_baseline_manage_search_24"
            app:key="trafficSniffing"
            app:summary="@string/traffic_sniffing_summary"
            app:title="@string/traffic_sniffing" />
        <Preference
            android:selectable="false"
            app:icon="@drawable/ic_baseline_info_24"
            android:summary="@string/explain_sniffing_summary"
            android:title="@string/explain_sniffing_title" />
    </PreferenceCategory>
    <PreferenceCategory app:title="@string/settings_group_protocol_rules">
        <light.rift.core.ui.SimpleMenuPreference
            app:defaultValue="0"
            app:entries="@array/ipv6_mode"
            app:entryValues="@array/int_array_4"
            app:icon="@drawable/ic_image_looks_6"
            app:key="ipv6Mode"
            app:title="@string/ipv6"
            app:useSimpleSummaryProvider="true" />
        <SwitchPreference
            app:defaultValue="false"
            app:icon="@drawable/ic_baseline_security_24"
            app:key="blockStun"
            app:summary="@string/block_stun_summary"
            app:title="@string/block_stun" />
        <!-- 路由资源更新源只做显示、不可选：源只剩 Rift 自编译一个，没什么好选的（用户 2026-11-23 定）。 -->
        <Preference
            android:selectable="false"
            app:icon="@drawable/ic_baseline_rule_folder_24"
            app:summary="@string/rules_provider_rift"
            app:title="@string/route_rules_provider" />
    </PreferenceCategory>
</PreferenceScreen>
